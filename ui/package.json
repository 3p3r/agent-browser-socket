{
  "name": "oatmeal-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/oatmeal-ui.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:pages": "run-s build:site build:pages:sb",
    "build:pages:sb": "storybook build --output-dir dist/storybook",
    "predev": "run-s -c predev:dir predev:link",
    "predev:dir": "shx mkdir -p public",
    "predev:link": "shx ln -sf ../../target/release/oatmeal public/oatmeal"
  },
  "dependencies": {
    "modern-normalize": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ua-parser-js": "^2.0.9"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.2",
    "@storybook/react": "^8.4.2",
    "@storybook/react-vite": "^8.4.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "npm-run-all": "^4.1.5",
    "shx": "^0.3.4",
    "storybook": "^8.4.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.10"
  }
}
