{
  "name": "oatmeal-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "E2E helpers for oatmeal",
  "type": "module",
  "scripts": {
    "format": "npm-run-all --parallel format:*",
    "format:rust": "cargo fmt",
    "format:js": "biome format --write",
    "build": "npm-run-all --parallel build:*",
    "build:native": "cargo build --release",
    "build:xwindows": "run-s build:xwindows:*",
    "build:xwindows:target": "rustup target add x86_64-pc-windows-msvc",
    "build:xwindows:xwin": "cargo install cargo-xwin --locked",
    "build:xwindows:build": "cross-env PATH=$(dirname $(which clang-cl)):$(dirname $(which lld-link)):$PATH cargo xwin build --release --target x86_64-pc-windows-msvc",
    "test:binary": "node tests/e2e-binary.mjs"
  },
  "dependencies": {
    "page-agent": "^1.5.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "cross-env": "^10.1.0",
    "npm-run-all": "^4.1.5"
  }
}
